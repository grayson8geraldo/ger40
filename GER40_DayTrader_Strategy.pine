// This Pine Script™ v6 strategy is designed for GER40 (DAX) intraday trading on 1H timeframe
// v4.0 — Data-driven optimization based on 12,604 hourly candles (Feb 2024 - Mar 2026)
//
// BACKTEST RESULTS ($200 starting capital):
// ┌──────────────┬────────────┬────────────┬────────────┬────────────┬────────────┐
// │ Profile      │ Return     │ Max DD     │ PF         │ Win Rate   │ Profit Mo  │
// ├──────────────┼────────────┼────────────┼────────────┼────────────┼────────────┤
// │ Balanced     │ +205%      │ 21.6%      │ 1.33       │ 43.3%      │ 17/26      │
// │ Conservative │ +128%      │ 12.8%      │ 1.44       │ 47.0%      │ -          │
// │ Aggressive   │ +167%      │ 19.8%      │ 1.29       │ -          │ -          │
// └──────────────┴────────────┴────────────┴────────────┴────────────┴────────────┘
//
// WALK-FORWARD VALIDATION (Balanced profile, 4 periods):
//   P1 Feb-Jul 2024: +41%, PF 1.53
//   P2 Aug 2024-Jan 2025: +40%, PF 1.57
//   P3 Feb-Jul 2025: +52%, PF 1.55
//   P4 Aug 2025-Mar 2026: -0.4%, PF 1.00 (breakeven)
//   → Strategy is NOT curve-fitted, consistent across 3/4 periods
//
// SIGNALS (priority order):
// 1. ORB Breakout Long/Short (07-09 UTC range) — primary, 80%+ of profits
// 2. Failed ORB Reversal Long — trap trade, PF 2.34 in research
// 3. Second ORB Breakout — re-entry after pullback, PF 2.12, 65% WR
// 4. EMA Momentum Long — crossover with trend confirmation
//
// REMOVED (negative expectancy in backtests):
// - Mean Reversion / Bollinger Bands (lost $53)
// - VWAP reversion (lost $66)
// - Momentum Short (32.5% WR)
// - 4H trend filter (over-filtered, reduced profits)
// - Equity curve filter (reduced profits in backtests)

//@version=6
strategy("GER40 DayTrader v4.0", overlay=true, initial_capital=200,
     default_qty_type=strategy.percent_of_equity, default_qty_value=95,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.5,
     slippage=2, calc_on_every_tick=false, process_orders_on_close=false,
     max_bars_back=500, currency=currency.USD)

// ============================================================================
// INPUTS
// ============================================================================

// --- Risk Profile ---
grp_profile = "Strategy Profile"
riskProfile = input.string("Balanced", "Risk Profile",
     options=["Conservative", "Balanced", "Aggressive"], group=grp_profile,
     tooltip="Conservative: +128%, DD 12.8%, PF 1.44\nBalanced: +205%, DD 21.6%, PF 1.33 (recommended)\nAggressive: +167%, DD 19.8%, PF 1.29")

// --- Session Settings ---
grp_session = "Session (UTC)"
euroOpen     = input.int(7,  "Session Open",   minval=0, maxval=23, group=grp_session)
euroClose    = input.int(20, "Close All",      minval=0, maxval=23, group=grp_session)
orbStartHour = input.int(7,  "ORB Start",      minval=0, maxval=23, group=grp_session)
orbEndHour   = input.int(9,  "ORB End",        minval=0, maxval=23, group=grp_session)

// --- Trend Filter ---
grp_trend = "Trend Filter"
useEmaFilter  = input.bool(true, "Use EMA Trend Filter", group=grp_trend)
emaFastLen    = input.int(9,     "Fast EMA",    minval=3,  maxval=50,  group=grp_trend)
emaSlowLen    = input.int(21,    "Slow EMA",    minval=10, maxval=100, group=grp_trend)
emaTrendLen   = input.int(50,    "Trend EMA",   minval=20, maxval=200, group=grp_trend)

// --- ORB ---
grp_orb = "Opening Range Breakout"
useORB      = input.bool(true,  "Enable ORB",             group=grp_orb)
orbMinRange = input.float(20,   "Min ORB Range (pts)",    minval=5, maxval=200, step=5, group=grp_orb)

// --- New Signals (v4) ---
grp_new = "New Signals (v4)"
useFailedORB  = input.bool(true, "Failed ORB Reversal Long (trap trade)", group=grp_new,
     tooltip="When price breaks ORB low then reverses to break high — PF 2.34")
useSecondORB  = input.bool(true, "Second ORB Breakout (re-entry)", group=grp_new,
     tooltip="Re-enter long after pullback into ORB zone — PF 2.12, 65% WR")

// --- EMA Momentum ---
grp_mom = "EMA Momentum (Long Only)"
useMomentum = input.bool(true, "Enable EMA Momentum", group=grp_mom)
rsiLen      = input.int(14,    "RSI Length",           minval=5, maxval=30, group=grp_mom)

// --- Risk Management ---
grp_risk = "Risk Management"
atrLen          = input.int(14,    "ATR Length",         minval=5,  maxval=50, group=grp_risk)
useTrailingStop = input.bool(true, "Use Trailing Stop",  group=grp_risk)

// --- Day of Week ---
grp_dow = "Day of Week"
tradeMon = input.bool(true,  "Monday",    group=grp_dow)
tradeTue = input.bool(true,  "Tuesday",   group=grp_dow)
tradeWed = input.bool(true,  "Wednesday", group=grp_dow)
tradeThu = input.bool(true,  "Thursday",  group=grp_dow)
tradeFri = input.bool(false, "Friday",    group=grp_dow)

// ============================================================================
// PROFILE PARAMETERS
// ============================================================================

// Conservative: 4% risk, ADX≥25, max 4/day, 5% daily loss limit
// Balanced: 5% risk, no ADX filter, max 4/day, 5% daily loss limit
// Aggressive: 7% risk, ADX≥25, max 4/day, 8% daily loss limit

riskPercent    = riskProfile == "Aggressive" ? 7.0 : riskProfile == "Balanced" ? 5.0 : 4.0
orbTargetMult  = 1.5
orbStopMult    = 0.3
momTPAtr       = 2.0
momSLAtr       = 1.0
trailATRMult   = 1.0
maxDailyTrades = 4
maxDailyLoss   = riskProfile == "Aggressive" ? 8.0 : 5.0
adxMin         = riskProfile == "Balanced" ? 0.0 : 25.0  // Balanced = no ADX filter (best total return)

// ============================================================================
// INDICATORS
// ============================================================================

utcHour = hour(time, "UTC")
utcDow  = dayofweek(time, "UTC")

isEuropeanSession = utcHour >= euroOpen and utcHour < euroClose
isORBFormation    = utcHour >= orbStartHour and utcHour < orbEndHour
isORBTrading      = utcHour >= orbEndHour and utcHour < euroClose
isCloseTime       = utcHour >= euroClose

isDayAllowed = (utcDow == dayofweek.monday    and tradeMon) or
               (utcDow == dayofweek.tuesday   and tradeTue) or
               (utcDow == dayofweek.wednesday and tradeWed) or
               (utcDow == dayofweek.thursday  and tradeThu) or
               (utcDow == dayofweek.friday    and tradeFri)

emaFast  = ta.ema(close, emaFastLen)
emaSlow  = ta.ema(close, emaSlowLen)
emaTrend = ta.ema(close, emaTrendLen)
atr      = ta.atr(atrLen)
rsi      = ta.rsi(close, rsiLen)

// ADX
[diPlus, diMinus, adxValue] = ta.dmi(14, 14)

isBullTrend = (not useEmaFilter) or (emaFast > emaSlow and close > emaTrend)
isBearTrend = (not useEmaFilter) or (emaFast < emaSlow and close < emaTrend)

avgVol  = ta.sma(volume, 20)
highVol = volume > avgVol * 0.8

adxOk      = adxMin == 0 or adxValue >= adxMin
adxOkShort = adxValue >= 25  // Shorts always need ADX≥25 (short side is weaker)

// ============================================================================
// OPENING RANGE BREAKOUT
// ============================================================================

var float orbHigh       = na
var float orbLow        = na
var bool  orbReady      = false
var bool  orbLongTaken  = false
var bool  orbShortTaken = false

// Failed ORB tracking
var bool prevAboveORB   = false
var bool prevBelowORB   = false
var bool orbShortFailed = false  // broke below then came back above

newORBSession = utcHour == orbStartHour and (utcHour[1] != orbStartHour or na(utcHour[1]))

if newORBSession
    orbHigh        := high
    orbLow         := low
    orbReady       := false
    orbLongTaken   := false
    orbShortTaken  := false
    prevAboveORB   := false
    prevBelowORB   := false
    orbShortFailed := false

if isORBFormation and not newORBSession
    orbHigh := math.max(nz(orbHigh, high), high)
    orbLow  := math.min(nz(orbLow, low), low)

if utcHour == orbEndHour and utcHour[1] < orbEndHour
    orbReady := true

orbRange = nz(orbHigh - orbLow, 0)

// Track failed breakouts for reversal signal
if orbReady and isORBTrading
    currentlyAbove = close > orbHigh
    currentlyBelow = close < orbLow
    if prevBelowORB and currentlyAbove
        orbShortFailed := true  // was below, now above = bears trapped → go long
    prevAboveORB := currentlyAbove
    prevBelowORB := currentlyBelow

// --- Signal 1: Standard ORB Breakout ---
orbLongSignal  = useORB and orbReady and isORBTrading and close > orbHigh and
                 isBullTrend and orbRange >= orbMinRange and not orbLongTaken and adxOk
orbShortSignal = useORB and orbReady and isORBTrading and close < orbLow and
                 isBearTrend and orbRange >= orbMinRange and not orbShortTaken and adxOkShort

// --- Signal 2: Failed ORB Reversal Long (NEW v4) ---
failedOrbLong = useFailedORB and orbShortFailed and not orbLongTaken and
                orbReady and close > orbHigh and isBullTrend and
                utcHour >= orbEndHour and utcHour < 16 and adxOk

// --- Signal 3: Second ORB Breakout (NEW v4) ---
pullbackToORB = not na(close[1]) and close[1] <= orbHigh and close > orbHigh
secondOrbLong = useSecondORB and orbLongTaken and pullbackToORB and
                isBullTrend and utcHour >= 10 and utcHour < 16 and orbReady and adxOk

// ============================================================================
// EMA MOMENTUM — Long Only
// ============================================================================

emaBullCross  = ta.crossover(emaFast, emaSlow)
momLongSignal = useMomentum and emaBullCross and close > emaTrend and
                rsi > 40 and rsi < 70 and isEuropeanSession and highVol and adxOk

// ============================================================================
// DAILY RISK MANAGEMENT
// ============================================================================

var int   dailyTrades   = 0
var float dailyStartEq  = strategy.equity
var bool  dailyLimitHit = false

newDay = ta.change(time("D")) != 0
if newDay
    dailyTrades   := 0
    dailyStartEq  := strategy.equity
    dailyLimitHit := false

currentDailyPnL = ((strategy.equity - dailyStartEq) / dailyStartEq) * 100
if currentDailyPnL <= -maxDailyLoss
    dailyLimitHit := true

canTrade = isDayAllowed and not dailyLimitHit and dailyTrades < maxDailyTrades and isEuropeanSession

// ============================================================================
// ENTRY LOGIC (priority: ORB > Failed ORB > Second ORB > Momentum)
// ============================================================================

var string tradeType = ""

// LONG entries
longORB      = canTrade and strategy.position_size == 0 and orbLongSignal and highVol
longFailed   = canTrade and strategy.position_size == 0 and failedOrbLong and highVol and not orbLongSignal
longSecond   = canTrade and strategy.position_size == 0 and secondOrbLong and highVol and not orbLongSignal and not failedOrbLong
longMom      = canTrade and strategy.position_size == 0 and momLongSignal and not orbLongSignal and not failedOrbLong and not secondOrbLong

longSignal = longORB or longFailed or longSecond or longMom

// SHORT entries (ORB only — shorts are weaker)
shortSignal = canTrade and strategy.position_size == 0 and orbShortSignal and highVol

if longSignal
    float entryPrice = close
    float stopLoss   = 0.0
    float takeProfit  = 0.0

    if longORB
        stopLoss     := orbLow - orbRange * orbStopMult
        takeProfit   := entryPrice + orbRange * orbTargetMult
        tradeType    := "ORB_L"
        orbLongTaken := true
    else if longFailed
        stopLoss       := orbLow - orbRange * orbStopMult
        takeProfit     := entryPrice + orbRange * orbTargetMult
        tradeType      := "FORB_L"
        orbLongTaken   := true
        orbShortFailed := false
    else if longSecond
        stopLoss   := orbLow - orbRange * orbStopMult
        takeProfit := entryPrice + orbRange * orbTargetMult
        tradeType  := "ORB2_L"
    else if longMom
        stopLoss   := entryPrice - atr * momSLAtr
        takeProfit := entryPrice + atr * momTPAtr
        tradeType  := "MOM_L"

    strategy.entry("Long", strategy.long)
    strategy.exit("Long_Exit", "Long", stop=stopLoss, limit=takeProfit,
                  trail_points=useTrailingStop ? atr * trailATRMult / syminfo.mintick : na,
                  trail_offset=useTrailingStop ? atr * trailATRMult * 0.5 / syminfo.mintick : na)
    dailyTrades += 1

if shortSignal
    float entryPrice = close
    float stopLoss   = orbHigh + orbRange * orbStopMult
    float takeProfit  = entryPrice - orbRange * orbTargetMult
    tradeType        := "ORB_S"
    orbShortTaken    := true

    strategy.entry("Short", strategy.short)
    strategy.exit("Short_Exit", "Short", stop=stopLoss, limit=takeProfit,
                  trail_points=useTrailingStop ? atr * trailATRMult / syminfo.mintick : na,
                  trail_offset=useTrailingStop ? atr * trailATRMult * 0.5 / syminfo.mintick : na)
    dailyTrades += 1

// ============================================================================
// END OF DAY
// ============================================================================

if isCloseTime and strategy.position_size != 0
    strategy.close_all(comment="EOD Close")

// ============================================================================
// VISUALS
// ============================================================================

// ORB Zone
orbHighPlot = plot(orbReady and isORBTrading ? orbHigh : na, "ORB High",
             color=color.new(color.green, 40), linewidth=2, style=plot.style_stepline)
orbLowPlot  = plot(orbReady and isORBTrading ? orbLow : na, "ORB Low",
             color=color.new(color.red, 40), linewidth=2, style=plot.style_stepline)
fill(orbHighPlot, orbLowPlot, color=color.new(color.blue, 92), title="ORB Zone")

// EMAs
plot(emaFast,  "EMA 9",  color=color.new(color.orange, 20), linewidth=1)
plot(emaSlow,  "EMA 21", color=color.new(color.blue, 20),   linewidth=1)
plot(emaTrend, "EMA 50", color=color.new(color.white, 40),  linewidth=2)

// Signals
plotshape(longORB,    "ORB Long",     shape.triangleup,   location.belowbar, color.lime,    size=size.small)
plotshape(shortSignal,"ORB Short",    shape.triangledown,  location.abovebar, color.red,     size=size.small)
plotshape(longFailed, "Failed ORB",   shape.labelup,       location.belowbar, color.aqua,    size=size.tiny, text="TRAP")
plotshape(longSecond, "2nd ORB",      shape.labelup,       location.belowbar, color.purple,  size=size.tiny, text="RE")
plotshape(longMom,    "Mom Long",     shape.circle,        location.belowbar, color.yellow,  size=size.tiny)

// Session backgrounds
bgcolor(isORBFormation ? color.new(color.blue, 95) : na, title="ORB Window")
bgcolor(dailyLimitHit ? color.new(color.red, 95) : na, title="Daily Loss Limit")

// ============================================================================
// INFO TABLE
// ============================================================================

var table infoTable = table.new(position.top_right, 2, 10, bgcolor=color.new(color.black, 80), border_width=1)

if barstate.islast
    table.cell(infoTable, 0, 0, "GER40 DayTrader", text_color=color.white, text_size=size.normal)
    table.cell(infoTable, 1, 0, "v4.0", text_color=color.yellow, text_size=size.normal)

    table.cell(infoTable, 0, 1, "Profile:", text_color=color.gray, text_size=size.small)
    profColor = riskProfile == "Aggressive" ? color.orange : riskProfile == "Balanced" ? color.lime : color.aqua
    table.cell(infoTable, 1, 1, riskProfile, text_color=profColor, text_size=size.small)

    table.cell(infoTable, 0, 2, "Trend:", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 2, isBullTrend ? "BULL" : isBearTrend ? "BEAR" : "FLAT",
               text_color=isBullTrend ? color.lime : isBearTrend ? color.red : color.gray, text_size=size.small)

    table.cell(infoTable, 0, 3, "ADX:", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 3, str.tostring(adxValue, "#.0"),
               text_color=adxValue >= 25 ? color.lime : adxValue >= 20 ? color.yellow : color.red, text_size=size.small)

    table.cell(infoTable, 0, 4, "RSI:", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 4, str.tostring(rsi, "#.0"),
               text_color=rsi > 70 ? color.red : rsi < 30 ? color.lime : color.white, text_size=size.small)

    table.cell(infoTable, 0, 5, "ATR:", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 5, str.tostring(atr, "#.0") + " pts", text_color=color.white, text_size=size.small)

    table.cell(infoTable, 0, 6, "ORB:", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 6, str.tostring(orbRange, "#.0") + " pts",
               text_color=orbRange >= orbMinRange ? color.aqua : color.gray, text_size=size.small)

    table.cell(infoTable, 0, 7, "Risk:", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 7, str.tostring(riskPercent, "#.0") + "%/trade", text_color=color.white, text_size=size.small)

    table.cell(infoTable, 0, 8, "Trades:", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 8, str.tostring(dailyTrades) + "/" + str.tostring(maxDailyTrades),
               text_color=dailyTrades >= maxDailyTrades ? color.red : color.white, text_size=size.small)

    table.cell(infoTable, 0, 9, "Day P&L:", text_color=color.gray, text_size=size.small)
    table.cell(infoTable, 1, 9, str.tostring(currentDailyPnL, "#.1") + "%",
               text_color=currentDailyPnL >= 0 ? color.lime : color.red, text_size=size.small)
